rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers base ───────────────────────────────────────────
    function isAuth()  { return request.auth != null; }
    function uid()     { return request.auth.uid; }
    function email()   { return request.auth.token.email; }

    // Documento del usuario actual (cross-document read)
    function myData() {
      return get(/databases/$(database)/documents/usuarios/$(uid())).data;
    }

    // ── Helpers de membresía ───────────────────────────────────

    // El usuario actual ES el admin de ese tenant (UID == tenantId)
    function isAdminOf(tenantId) {
      return isAuth() && uid() == tenantId;
    }

    // El usuario es miembro activo de la empresa (admin propio O vendedor activo vinculado)
    function isMemberOf(tenantId) {
      return isAuth() && (
        uid() == tenantId ||
        (myData().empresaId == tenantId &&
         myData().rol       == 'vendedor' &&
         myData().activo    == true)
      );
    }

    // El usuario es el admin-empresa del vendedorId dado
    function isAdminOfVendedor(vendedorId) {
      return isAuth() &&
        get(/databases/$(database)/documents/usuarios/$(vendedorId)).data.empresaId == uid();
    }

    // ── Validaciones de escritura ──────────────────────────────

    // Al crear: vendedorId = UID propio, tenantId = UID propio o empresaId real
    function validNewDoc() {
      let d = request.resource.data;
      return isAuth() &&
        d.vendedorId == uid() &&
        (d.tenantId == uid() || d.tenantId == myData().empresaId);
    }

    // Al actualizar: los campos de identidad no pueden cambiar nunca
    function identityUnchanged() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(['vendedorId', 'tenantId']);
    }

    // ── Validaciones anti-abuso ────────────────────────────────

    // Límite de tamaño en campos de texto (previene payloads masivos)
    function camposTextoValidos(d) {
      return (!d.keys().hasAll(['notas'])       || d.notas.size()      <= 2000)
          && (!d.keys().hasAll(['nombre'])      || d.nombre.size()     <= 200)
          && (!d.keys().hasAll(['descripcion']) || d.descripcion.size()<= 1000)
          && (!d.keys().hasAll(['referencia'])  || d.referencia.size() <= 500);
    }

    // creadoEn debe estar dentro de ±5 min del servidor (previene backdating manual)
    function timestampValido() {
      let d = request.resource.data;
      return !d.keys().hasAll(['creadoEn']) ||
        (d.creadoEn is timestamp &&
         d.creadoEn >= request.time - duration.value(300, 's') &&
         d.creadoEn <= request.time + duration.value(60,  's'));
    }

    // Coherencia matemática mínima de una venta: total/subtotal no negativos,
    // y total == subtotal - descValor (con tolerancia de punto flotante).
    // Previene que un vendedor registre, llamando directo al SDK, una venta
    // de items costosos con un total artificialmente bajo (o negativo).
    function montoVentaValido() {
      let d = request.resource.data;
      return d.total is number && d.total >= 0
        && d.subtotal is number && d.subtotal >= 0
        && d.descValor is number && d.descValor >= 0
        && (d.total - (d.subtotal - d.descValor) < 0.02)
        && ((d.subtotal - d.descValor) - d.total < 0.02);
    }

    // ── USUARIOS ──────────────────────────────────────────────
    match /usuarios/{userId} {
      // Solo propio doc, o admin leyendo a sus vendedores directos
      allow read: if isAuth() && (
        uid() == userId ||
        get(/databases/$(database)/documents/usuarios/$(userId)).data.empresaId == uid()
      );
      // Creación: solo el propio usuario, el UID debe coincidir
      allow create: if isAuth()
        && uid() == userId
        && request.resource.data.uid == userId
        // No puede auto-asignarse rol admin si no es el primer usuario de la empresa
        // (setup lo hace siempre con rol='admin' o rol='vendedor', nunca otro)
        && (request.resource.data.rol == 'admin' || request.resource.data.rol == 'vendedor');

      // Actualización: solo propio doc, y NUNCA cambiar campos de seguridad
      allow update: if isAuth()
        && uid() == userId
        && !request.resource.data.diff(resource.data)
             .affectedKeys().hasAny(['rol', 'empresaId', 'tenantId', 'uid']);

      // El admin de la empresa puede desactivar/reactivar sus vendedores.
      // SECURITY: whitelist explícita (no lista negra) — el admin SOLO puede
      // tocar 'activo' y 'actualizadoEn'. Cualquier campo nuevo que se agregue
      // a /usuarios en el futuro queda protegido por defecto.
      allow update: if isAuth()
        && uid() != userId
        && get(/databases/$(database)/documents/usuarios/$(userId)).data.empresaId == uid()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['activo', 'actualizadoEn']);

      allow delete: if false;
    }

    // ── CONFIG (por empresa) ───────────────────────────────────
    match /config/{configId} {
      allow read:  if isAuth() && isMemberOf(configId);
      allow write: if isAuth() && isAdminOf(configId);
    }

    // ── EMPRESAS ──────────────────────────────────────────────
    match /empresas/{empresaId} {
      allow read:  if isAuth() && isMemberOf(empresaId);
      // Solo el admin de esa empresa puede modificarla
      allow write: if isAuth() && isAdminOf(empresaId);
    }

    // ── CLIENTES ──────────────────────────────────────────────
    match /clientes/{docId} {
      // Lectura: propio vendedor, su admin, o admin de empresa (tenantId)
      allow read: if isAuth() && (
        resource.data.vendedorId == uid() ||
        resource.data.tenantId   == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
      allow create: if isAuth()
        && validNewDoc()
        && camposTextoValidos(request.resource.data);

      // SECURITY: si 'deuda' cambia, SOLO puede ir acompañado de
      // 'actualizadoEn'/'ultimaVisita' (los campos que tocan las
      // transacciones atómicas en agregarVenta/registrarPago/marcarVentaPagada).
      // Esto bloquea que alguien actualice 'deuda' junto con campos de texto
      // arbitrarios desde una llamada manual fuera de esos flujos auditados.
      allow update: if isAuth()
        && identityUnchanged()
        && camposTextoValidos(request.resource.data)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deuda']) ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deuda', 'actualizadoEn', 'ultimaVisita'])
        )
        && (
          resource.data.vendedorId == uid() ||
          resource.data.tenantId   == uid() ||
          isAdminOfVendedor(resource.data.vendedorId)
        );
      // Soft delete — nunca borrado físico para preservar historial
      allow delete: if false;
    }

    // ── PRODUCTOS ─────────────────────────────────────────────
    match /productos/{docId} {
      // Cualquier miembro activo de la empresa puede leer el catálogo
      allow read: if isAuth() && isMemberOf(resource.data.tenantId);

      // Solo el admin puede crear productos del catálogo
      allow create: if isAuth() && isAdminOf(request.resource.data.tenantId);

      // Admin: cualquier campo | Vendedor activo: SOLO reducir stock (al vender),
      // y el stock resultante nunca puede quedar negativo (defensa en profundidad —
      // el cliente también valida esto en una transacción antes de escribir).
      allow update: if isAuth() && (
        isAdminOf(resource.data.tenantId) ||
        (isMemberOf(resource.data.tenantId) &&
         request.resource.data.diff(resource.data)
           .affectedKeys().hasOnly(['stock', 'actualizadoEn']) &&
         request.resource.data.stock <= resource.data.stock &&
         request.resource.data.stock >= 0)
      );
      // Soft delete — nunca borrado físico
      allow delete: if false;
    }

    // ── VENTAS ────────────────────────────────────────────────
    match /ventas/{docId} {
      // Admin ve todas las ventas de su empresa; vendedor solo las propias
      allow read: if isAuth() && (
        resource.data.tenantId   == uid() ||
        resource.data.vendedorId == uid()
      );
      allow create: if isAuth()
        && validNewDoc()
        && camposTextoValidos(request.resource.data)
        && timestampValido()
        && montoVentaValido();

      // Admin (tenantId==uid): puede actualizar cualquier campo NO de identidad
      // Vendedor (solo sus ventas): NO puede tocar campos financieros ni de identidad
      allow update: if isAuth() && (
        (resource.data.tenantId == uid() && identityUnchanged()) ||
        (resource.data.vendedorId == uid() &&
         !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['total', 'subtotal', 'descuento', 'descValor',
                                    'vendedorId', 'tenantId', 'clienteId', 'items']))
      );
      // Ninguna venta se borra — historial permanente
      allow delete: if false;
    }

    // ── VISITAS ───────────────────────────────────────────────
    match /visitas/{docId} {
      allow read: if isAuth() && (
        resource.data.vendedorId == uid() ||
        resource.data.tenantId   == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
      allow create: if isAuth() && validNewDoc();
      allow update: if isAuth() && identityUnchanged() && (
        resource.data.vendedorId == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
      // Visitas permanentes — no se borran
      allow delete: if false;
    }

    // ── RUTAS ─────────────────────────────────────────────────
    match /rutas/{docId} {
      allow read: if isAuth() && (
        resource.data.vendedorId == uid() ||
        resource.data.tenantId   == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
      allow create: if isAuth() && validNewDoc();
      allow update: if isAuth() && identityUnchanged() && (
        resource.data.vendedorId == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
      // Rutas sí permiten borrado físico (no tienen historial financiero)
      allow delete: if isAuth() && (
        resource.data.vendedorId == uid() ||
        resource.data.tenantId   == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
    }

    // ── PAGOS ─────────────────────────────────────────────────
    match /pagos/{docId} {
      allow read: if isAuth() && (
        resource.data.vendedorId == uid() ||
        resource.data.tenantId   == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
      allow create: if isAuth() && validNewDoc();
      // INMUTABLES — ningún pago puede modificarse ni borrarse
      allow update: if false;
      allow delete: if false;
    }

    // ── INVENTARIO ────────────────────────────────────────────
    match /inventario/{docId} {
      allow read: if isAuth() && (
        resource.data.vendedorId == uid() ||
        resource.data.tenantId   == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
      allow create: if isAuth() && validNewDoc();
      allow update: if isAuth() && identityUnchanged() && (
        resource.data.vendedorId == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
      allow delete: if isAuth() && (
        resource.data.vendedorId == uid() ||
        resource.data.tenantId   == uid() ||
        isAdminOfVendedor(resource.data.vendedorId)
      );
    }

    // ── INVITACIONES ──────────────────────────────────────────
    match /invitaciones/{docId} {
      // Solo el admin creador o el email invitado pueden leerla
      allow read: if isAuth() && (
        resource.data.adminId       == uid() ||
        resource.data.emailInvitado == email()
      );
      // Solo admin puede crear, y debe ser su propia empresa
      allow create: if isAuth()
        && request.resource.data.adminId   == uid()
        && request.resource.data.empresaId == uid()
        // Validar que el email invitado no sea el propio admin
        && request.resource.data.emailInvitado != email();

      // Admin puede cancelarla; el invitado puede aceptarla
      allow update: if isAuth() && (
        resource.data.adminId       == uid() ||
        resource.data.emailInvitado == email()
      );
      // Solo el admin que la creó puede eliminarla
      allow delete: if isAuth() && resource.data.adminId == uid();
    }

    // ── FCM TOKENS (notificaciones push) ──────────────────────
    // El token se guarda en el doc del usuario (campo fcmToken),
    // ya cubierto por la regla de /usuarios. Esta colección no existe
    // separada — no se necesita regla adicional.

    // ── CATCH-ALL: bloquear cualquier colección no declarada ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
